# Токен бота от @BotFather
BOT_TOKEN=вставьте_токен_от_BotFather

# Публичный HTTPS-URL мини-аппа.
# Для локальных тестов поднимите ngrok-туннель (см. README.md) и вставьте его URL.
WEBAPP_URL=https://xxxx.ngrok-free.app

# Порт локального веб-сервера aiohttp.
# Локально — 8080, на Amvera задайте PORT=80 (см. README.md).
PORT=8080

# Путь к файлу SQLite с данными пользователей
DB_PATH=users.db

# DEBUG=1 включает подробные логи цепочки «онбординг → API → фронт»
DEBUG=0
